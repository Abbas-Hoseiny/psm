---
// Bootstrap + Icons lokal gebündelt (kein CDN): schnellerer First Paint, kein
// Drittanbieter-Roundtrip, offline-fähig über den Service-Worker-Precache.
import 'bootstrap/dist/css/bootstrap.min.css';
import 'bootstrap-icons/font/bootstrap-icons.min.css';
import '../styles/theme.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/components.css';
import '../styles/guidedInput.css';

interface Props {
  title?: string;
  description?: string;
  /** Hintergrund der Seite: Startfoto (App-Start) oder ruhiger Verlauf. */
  bodyClass?: string;
}

const baseTitle = 'Digitale PSM';
const {
  title: pageTitle = '',
  description =
    'Pflanzenschutzmittel berechnen und Anwendungen dokumentieren: mit BVL-Daten, JSON-Export und PDF. Kostenlos, ohne Konto, mit lokaler Datenspeicherung.',
  bodyClass = 'bg-startup',
} = Astro.props as Props;
const fullTitle = pageTitle
  ? `${pageTitle} · ${baseTitle}`
  : 'Digitale PSM – Pflanzenschutz einfach dokumentieren';
// Nur der produktive Host und Pfad, keine Kampagnen- oder PWA-Parameter.
const siteUrl = Astro.site ?? new URL('https://digitale-psm.de/');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const previewImageUrl = new URL('/assets/img/og-digitale-psm-2026-11.jpg', siteUrl).href;
const previewImageAlt = 'Digitale PSM: Pflanzenschutz einfach dokumentieren – JSON-Export, PDF und lokale Daten.';
const isHome = Astro.url.pathname === '/';
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl.href}#website`,
      url: siteUrl.href,
      name: baseTitle,
      inLanguage: 'de-DE',
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: fullTitle,
      description,
      inLanguage: 'de-DE',
      isPartOf: { '@id': `${siteUrl.href}#website` },
      primaryImageOfPage: {
        '@type': 'ImageObject', url: previewImageUrl, width: 1200, height: 630,
      },
      ...(isHome ? { mainEntity: { '@id': `${siteUrl.href}#app` } } : {}),
    },
    ...(isHome ? [{
      '@type': 'WebApplication',
      '@id': `${siteUrl.href}#app`,
      name: baseTitle,
      url: siteUrl.href,
      description,
      image: previewImageUrl,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Windows, macOS, Linux',
      browserRequirements: 'Chrome oder Edge am Computer mit File System Access API und aktiviertem JavaScript',
      inLanguage: 'de-DE',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
      license: 'https://github.com/Abbas-Hoseiny/psm/blob/main/LICENSE',
      author: { '@type': 'Person', name: 'Abbas Hoseiny', url: 'https://hoseiny.de/' },
      featureList: [
        'Pflanzenschutzmittel-Mengen berechnen',
        'Pflanzenschutz-Anwendungen dokumentieren',
        'Offizielle BVL-Zulassungsdaten durchsuchen',
        'Maschinenlesbarer JSON- und ZIP-Export',
        'PDF und Druck',
        'Lokale Datenbank und Offline-Nutzung',
      ],
    }] : []),
  ],
}).replace(/</g, '\\u003c');
---

<!DOCTYPE html>
<html lang="de" data-bs-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <link rel="canonical" href={canonicalUrl} />
  <meta name="description" content={description} />
  <meta name="author" content="Abbas Hoseiny" />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta name="theme-color" content="#22c55e" />
  <meta property="og:site_name" content={baseTitle} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={previewImageUrl} />
  <meta property="og:image:secure_url" content={previewImageUrl} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={previewImageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={previewImageUrl} />
  <meta name="twitter:image:alt" content={previewImageAlt} />
  <link rel="icon" type="image/svg+xml" href="/assets/img/favicon.svg" />
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/img/psm-icon-192.png" />
  <link rel="apple-touch-icon" sizes="192x192" href="/assets/img/psm-icon-192.png" />
  
  <!-- PWA Manifest -->
  <link rel="manifest" href="/manifest.json" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="DigitalePSM" />
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
  <link rel="describedby" type="text/plain" href="/llms.txt" />
  <script type="application/ld+json" set:html={structuredData} />
  <slot name="head" />
</head>
<body class={bodyClass}>
  <noscript>
    <style>[data-region="startup"] button[data-action] { display: none; }</style>
    <div class="noscript-warning">
      Die interaktive App benötigt JavaScript. Die Beschreibung und die
      <a href="/anleitung/">Anleitung</a> kannst du auch ohne JavaScript lesen.
    </div>
  </noscript>
  
  <div id="app-root" class="app-root">
    <slot />
  </div>
</body>
</html>
