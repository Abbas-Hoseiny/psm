---
// Shell component - Navigation and Footer
const currentYear = new Date().getFullYear();
---

<div data-region="shell" class="d-none">
  <nav class="navbar navbar-dark navbar-expand-lg mb-4 no-print shell-navbar">
    <div class="container-fluid">
      <a class="navbar-brand d-flex align-items-center gap-2" href="#" id="brand-link">
        <i class="bi bi-leaf-fill" style="color: var(--color-primary);"></i>
        <div class="brand-copy d-flex flex-column">
          <span class="brand-title" id="brand-title">Pflanzenschutz</span>
          <span class="brand-tagline small" style="color: var(--color-text-muted);" id="brand-tagline"></span>
        </div>
      </a>
      
      <!-- Offline Status Indicator -->
      <span id="offline-indicator" class="d-none badge rounded-pill" style="background: var(--warning-600); color: #000; font-size: 0.75rem; padding: 0.35em 0.65em;">
        <i class="bi bi-wifi-off me-1"></i>Offline
      </span>
      
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item">
            <button class="btn btn-psm-secondary-outline nav-btn" data-section="calc">
              <i class="bi bi-pencil-square"></i> Neu erfassen
            </button>
          </li>
          <li class="nav-item">
            <button class="btn btn-psm-secondary-outline nav-btn" data-section="settings">
              <i class="bi bi-gear"></i> Einstellungen
            </button>
          </li>
          <li class="nav-item">
            <button class="btn btn-psm-secondary-outline nav-btn" data-section="documentation">
              <i class="bi bi-list-ul"></i> Übersicht
            </button>
          </li>
        </ul>
      </div>
    </div>
  </nav>
</div>

<footer data-region="footer" class="site-footer no-print d-none">
  <div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center">
      <small class="text-muted">
        © {currentYear} Digitale PSM ·
        <a
          href="https://info.digitale-psm.de"
          target="_blank"
          rel="noopener noreferrer"
          class="text-reset text-decoration-underline"
        >
          <i class="bi bi-info-circle me-1" aria-hidden="true"></i>Info & Lizenz
        </a>
      </small>
    </div>
  </div>
</footer>

<style>
  .shell-navbar {
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: var(--shadow-md);
  }
  
  .nav-btn {
    margin: 0 0.25rem;
    border-radius: var(--radius-md);
    min-height: 40px;
  }
  
  .nav-btn.active {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
  }
  
  .brand-logo {
    max-height: 40px;
    max-width: 40px;
  }

  @media print {
    .no-print {
      display: none !important;
    }
  }
</style>
